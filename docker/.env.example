# Copy to .env next to docker-compose.yml.

# Database (used by both the PostgreSQL container and WafControl)
DB_NAME=wafcontrol
DB_USER=wafcontrol
DB_PASS=change-me

# Hosts/IPs you open the panel with, comma separated (e.g. 192.168.0.21,waf.example.com)
ALLOWED_HOSTS=localhost,127.0.0.1
# Over plain HTTP the secure-cookie flags must be off; set True behind HTTPS.
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
# With HTTPS / a domain:
#CSRF_TRUSTED_ORIGINS=https://waf.example.com
#SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# First admin, created on first start only
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-too
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Optional
#SECRET_KEY=            # generated and kept in the data volume when empty
#GUNICORN_WORKERS=4
#GITHUB_TOKEN=          # raises GitHub's rate limit for CRS release checks
#PANEL_PORT=7000
#HTTP_PORT=80
#HTTPS_PORT=443
#REPO_URL=https://github.com/aedkymish/wafcontrol.git
#REPO_BRANCH=main
#HTTPS_PROXY=http://proxy.example:8080
#https_proxy=http://proxy.example:8080
#NO_PROXY=localhost,127.0.0.1,db,redis
